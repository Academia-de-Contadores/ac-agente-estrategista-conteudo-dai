{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academia-de-contadores.local/schemas/knowledge-manifest.schema.json",
  "title": "Curated Knowledge manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "selection_status", "counts", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "selection_status": {"enum": ["selected_with_evidence", "pending_human_review", "blocked_identity"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_upload", "observed_sets"],
      "properties": {
        "active_upload": {"type": "integer", "minimum": 0, "maximum": 20},
        "observed_sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "count"],
            "properties": {"label": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 0}}
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role", "upload"],
        "properties": {
          "path": {"type": "string", "pattern": "^knowledge/(source|upload)/[^/]+(?:/[^/]+)*$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"enum": ["source", "upload_active", "reference_only", "archive"]},
          "upload": {"type": "boolean"}
        }
      }
    }
  }
}
